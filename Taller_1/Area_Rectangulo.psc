Algoritmo Area_Rectangulo
	Definir b, h, aR Como Real
	
	Escribir "=== CALCULAR ÁREA DEL RECTÁNGULO ==="
	Escribir "Ingrese la base del rectángulo:"
	Leer b
	Escribir "Ingrese la altura del rectángulo:"
	Leer h
	
	aR <- b * h
	
	Escribir "Base: ", b
	Escribir "Altura: ", h
	Escribir "Área del rectángulo: ", aR
FinAlgoritmo