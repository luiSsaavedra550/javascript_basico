Algoritmo Area_Rombo
	Definir dMen, dMay, aRombo Como Real
	
	Escribir "=== CALCULAR ÁREA DEL ROMBO ==="
	Escribir "Ingrese la diagonal menor del rombo:"
	Leer dMen
	Escribir "Ingrese la diagonal mayor del rombo:"
	Leer dMay
	
	aRombo <- (dMen * dMay) / 2
	
	Escribir "Diagonal menor: ", dMen
	Escribir "Diagonal mayor: ", dMay
	Escribir "Área del rombo: ", aRombo
FinAlgoritmo