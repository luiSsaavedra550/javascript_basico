Algoritmo Convertir_Temperatura
	Definir cC, gF Como Real
	
	Escribir "=== CONVERTIR TEMPERATURA ==="
	Escribir "Ingrese la temperatura en grados Centígrados:"
	Leer cC
	
	gF <- (cC * 9/5) + 32
	
	Escribir "Temperatura en grados Centígrados: ", cC, " °C"
	Escribir "Temperatura en grados Fahrenheit: ", gF, " °F"
FinAlgoritmo