Algoritmo Intervalos
    Definir numero Como Real
	
    Escribir "Digite un numero:"
    Leer numero
	
    Si numero < 20 Entonces
        Escribir "El numero es menor a 20"
    Sino
        Si numero <= 50 Entonces
            Escribir "El numero esta entre 20 y 50"
        Sino
            Si numero <= 69 Entonces
                Escribir "El numero esta entre 51 y 69"
            Sino
                Si numero <= 120 Entonces
                    Escribir "El numero esta entre 70 y 120"
                Sino
                    Si numero <= 149 Entonces
                        Escribir "El numero esta entre 121 y 149"
                    Sino
                        Si numero <= 300 Entonces
                            Escribir "El numero esta entre 150 y 300"
                        Sino
                            Escribir "El numero no se encuentra en ningun intervalo"
                        FinSi
                    FinSi
                FinSi
            FinSi
        FinSi
    FinSi
	
FinAlgoritmo